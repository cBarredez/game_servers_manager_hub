{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameserver-manager.local/contracts/v1/server-manager-contract.schema.json",
  "title": "Server Manager Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "managerId", "gameType", "displayName", "driver", "requiredContainerRoles", "capabilities", "secretSlots"],
  "properties": {
    "$schema": { "type": "string" },
    "contractVersion": { "const": "1.0" },
    "managerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "gameType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "entrypoint"],
      "properties": {
        "protocolVersion": { "const": "1.0" },
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "requiredContainerRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "secretSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "required"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "enum": ["podman"] },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
